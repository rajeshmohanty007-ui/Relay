rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    
    

    match /nodes/{nodeId} {
      allow read: if true;
      allow write: if false;
    }

    match /edges/{edgeId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /convoys/{convoyId} {
      allow read: if true;
      allow write: if false;
    }

    match /demoConfig/{configId} {
      allow read: if true;
      allow write: if false;
    }

    
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
